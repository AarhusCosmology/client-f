# Read by submit_client.sh, smoke/submit_timing.sh and analysis/submit_true_check.sh.
#
# CLIENT_REFUSED_VALUE is NOT set (Steen's decision of 21 October 2026). The refused points of the first
# set were not a refused region but isolated points inside the posterior's plateau (delta_Neff < 0.05,
# f_idm 0.1-0.8; 0.02% of the points inside this prior, 0.04-0.08% in the low delta_Neff part) where
# CLASS++ on Grendel returns NaN spectra and the laptop computes normal ones (results/
# 20261021_classpp_nan_report). With the setting unset the launcher makes such a point -inf
# (refused.py counts a NaN log-posterior as refused since that day): it is left out of training rather
# than trained on as -42 300, and it weighs zero in the boosts' and the true check's corrections.
unset CLIENT_REFUSED_VALUE

# CLASS++ 7cc41a51 WITH the extrapolation guard (Steen's decision of 21 October 2026): built by
# install/09_classpp_guard.sh from smoke/classpp_extrap_guard.patch into a folder of its own; the env's classy
# is not used by this run. At points with dark acoustic oscillations (f_idm >~ 0.2, late z_stop) halofit and
# HMcode extrapolated the sources beyond k_max through a fit that crosses zero or overflows, and gave NaN
# spectra or wild non-linear corrections; elsewhere the spectra are those of the unpatched build
# (smoke/submit_guard_test.sh). Without the build the job stops here rather than run with another CLASS++.
# CLASSPP_GUARD_DIR also tells install/check.py to require this build (its patch and commit) in place of
# the env's classy.
export CLASSPP_GUARD_DIR="$HOME/codes/classpp_7cc41a51_guard"
ls "$CLASSPP_GUARD_DIR"/lib/classy*.so >/dev/null 2>&1 \
  || { echo "FATAL: no patched CLASS++ in $CLASSPP_GUARD_DIR/lib: run install/09_classpp_guard.sh first" >&2; return 1; }
export PYTHONPATH="$CLASSPP_GUARD_DIR/lib${PYTHONPATH:+:$PYTHONPATH}"
