# Read by submit_client.sh, smoke/submit_timing.sh and analysis/submit_true_check.sh.
#
# CLASS++ may refuse some corners of the box (none of the seven points tried on the laptop on
# 20 October 2026 failed: strong coupling at logGeff -0.8, G/aH 1e14, f_idm 1, delta_Neff 2);
# Cobaya then returns -inf (stop_at_error: false). A run trains on such points with a value taken
# from its own design (refused.py), as the axion, 49-parameter and HiLLiK runs do.
export CLIENT_REFUSED_VALUE=${CLIENT_REFUSED_VALUE:-design}
