# Read by submit_client.sh, smoke/submit_timing.sh and analysis/submit_true_check.sh.
# The decaying-neutrino proxy runs of 5 November 2026 (runs/dncdm_proxy_pp, runs/dncdm_proxy_wc).
#
# CLIENT_REFUSED_VALUE is NOT set, as in the SIDR + DRMD runs: a point CLASS++ or a likelihood cannot evaluate is -inf,
# left out of training, weight zero in the corrections.
unset CLIENT_REFUSED_VALUE

# CLASS++ master cb2255f4 (5 November 2026, #499), UNPATCHED, built by install/10_classpp_build.sh into a folder of its
# own; the env's classy (7cc41a51) is not used by this run. Since 7cc41a51 the decaying-neutrino species has been
# corrected twice in ways that change its spectra: #495 (stale parent state in the Einstein equations) and #499 (the
# momentum quadrature's drivers normalised to rho + p). CLASSPP_BUILD_DIR and CLASSPP_BUILD_COMMIT also tell
# install/check.py, launch.py and the profile backend to require this build (boltzmann_build.py). Without it the job
# stops here rather than run with another CLASS++.
export CLASSPP_BUILD_DIR="$HOME/codes/classpp_cb2255f4" CLASSPP_BUILD_COMMIT=cb2255f4
ls "$CLASSPP_BUILD_DIR"/lib/classy*.so >/dev/null 2>&1 \
  || { echo "FATAL: no CLASS++ cb2255f4 in $CLASSPP_BUILD_DIR/lib: run install/10_classpp_build.sh cb2255f4 first" >&2; return 1; }
export PYTHONPATH="$CLASSPP_BUILD_DIR/lib${PYTHONPATH:+:$PYTHONPATH}"
