# Read by submit_client.sh, smoke/submit_timing.sh, smoke/submit_axion_probe.sh and analysis/submit_true_check.sh.
#
# Refused points: a run trains on them with a value taken from its own design (refused.py), as the earlier axion
# runs, the 49-parameter and HiLLiK runs do: where the likelihood refuses a point (in the TT run, Commander low-l TT
# out of its table at low-A_s/high-tau/large-A_osc corners of the box) it is a region, and a value from the design
# keeps the network low there rather than leaving it to extrapolate.
export CLIENT_REFUSED_VALUE=${CLIENT_REFUSED_VALUE:-design}

# CLASS++ master 0a57bbc6 (27 October 2026), unpatched, built by install/10_classpp_build.sh into a folder of its own:
# the newest CLASS++ when the axion runs were set up, used by both data sets of the axion study (cobaya.yaml's header). CLASSPP_BUILD_DIR and CLASSPP_BUILD_COMMIT also tell install/check.py,
# launch.py and the profile backend to require this build (boltzmann_build.py). Without it the job stops here rather
# than run with another CLASS++.
export CLASSPP_BUILD_DIR="$HOME/codes/classpp_0a57bbc6" CLASSPP_BUILD_COMMIT=0a57bbc6
ls "$CLASSPP_BUILD_DIR"/lib/classy*.so >/dev/null 2>&1 \
  || { echo "FATAL: no CLASS++ 0a57bbc6 in $CLASSPP_BUILD_DIR/lib: run install/10_classpp_build.sh 0a57bbc6 first" >&2; return 1; }
export PYTHONPATH="$CLASSPP_BUILD_DIR/lib${PYTHONPATH:+:$PYTHONPATH}"
